# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.

# Provedor: openai, anthropic, arquivo (copiar e colar no chat, sem chave) ou fake (simulação)
PROVEDOR=openai

# Nome exato do modelo, como aparece no painel do provedor.
# Exemplos: gpt-5-mini (OpenAI) ou claude-haiku-4-5 (Anthropic)
MODELO=

# Só a chave do provedor escolhido é necessária
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Deixe comentado para usar o padrão do provedor (modelos recentes podem recusar temperatura)
# TEMPERATURA=0.2
